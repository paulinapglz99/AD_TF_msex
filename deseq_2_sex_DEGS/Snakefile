# ==============================================================================
# Snakemake Workflow: Sex-Stratified Differential Expression in Alzheimer's
# ==============================================================================
# Author: [Your Name]
# Date: 2026-04-29
# Description: Automated pipeline for DESeq2 analysis comparing:
#   1. AD vs Control in males
#   2. AD vs Control in females  
#   3. Sex × Diagnosis interaction (differential AD effect between sexes)
# ==============================================================================

import os
from pathlib import Path

# ==============================================================================
# CONFIGURATION
# ==============================================================================

configfile: "config.yaml"

# Default values if not in config
BRAIN_AREAS = config.get("brain_areas", ["CRB", "TC"])
PADJ_THRESH = config.get("padj_threshold", 0.05)
LFC_THRESH = config.get("lfc_threshold", 0.5)
CORES = config.get("cores", 4)

# Input paths
COUNTS_DIR = config.get("counts_dir", "data/counts")
METADATA_DIR = config.get("metadata_dir", "data/metadata")

# Output directory
OUTDIR = config.get("outdir", "results")

# ==============================================================================
# HELPER FUNCTIONS
# ==============================================================================

def get_counts_file(wildcards):
    """Get counts file path for a given brain area"""
    return os.path.join(COUNTS_DIR, f"{wildcards.area}_counts.rds")

def get_metadata_file(wildcards):
    """Get metadata file path for a given brain area"""
    return os.path.join(METADATA_DIR, f"{wildcards.area}_metadata.csv")

# ==============================================================================
# TARGET RULES
# ==============================================================================

rule all:
    input:
        # DEG tables
        expand(os.path.join(OUTDIR, "{area}", "{area}_males_AD_vs_control_DEGs.csv"),
               area=BRAIN_AREAS),
        expand(os.path.join(OUTDIR, "{area}", "{area}_females_AD_vs_control_DEGs.csv"),
               area=BRAIN_AREAS),
        expand(os.path.join(OUTDIR, "{area}", "{area}_sex_diagnosis_interaction_DEGs.csv"),
               area=BRAIN_AREAS),
        # Volcano plots
        expand(os.path.join(OUTDIR, "{area}", "{area}_males_volcano.png"),
               area=BRAIN_AREAS),
        expand(os.path.join(OUTDIR, "{area}", "{area}_females_volcano.png"),
               area=BRAIN_AREAS),
        expand(os.path.join(OUTDIR, "{area}", "{area}_interaction_volcano.png"),
               area=BRAIN_AREAS),
        # Summary
        expand(os.path.join(OUTDIR, "{area}", "{area}_summary.csv"),
               area=BRAIN_AREAS),
        # Final report
        os.path.join(OUTDIR, "final_report.html")

# ==============================================================================
# ANALYSIS RULES
# ==============================================================================

rule deseq2_analysis:
    """
    Run DESeq2 sex-stratified analysis for one brain area
    Produces three contrasts:
      1. Males: AD vs Control
      2. Females: AD vs Control
      3. Sex × Diagnosis interaction
    """
    input:
        counts = get_counts_file,
        metadata = get_metadata_file,
        script = "deseq2_sex_ad_analysis.R"
    output:
        # Males
        males_degs = os.path.join(OUTDIR, "{area}", "{area}_males_AD_vs_control_DEGs.csv"),
        males_all = os.path.join(OUTDIR, "{area}", "{area}_males_AD_vs_control_all_genes.csv"),
        males_rds = os.path.join(OUTDIR, "{area}", "{area}_males_AD_vs_control_results.rds"),
        males_volcano = os.path.join(OUTDIR, "{area}", "{area}_males_volcano.png"),
        # Females
        females_degs = os.path.join(OUTDIR, "{area}", "{area}_females_AD_vs_control_DEGs.csv"),
        females_all = os.path.join(OUTDIR, "{area}", "{area}_females_AD_vs_control_all_genes.csv"),
        females_rds = os.path.join(OUTDIR, "{area}", "{area}_females_AD_vs_control_results.rds"),
        females_volcano = os.path.join(OUTDIR, "{area}", "{area}_females_volcano.png"),
        # Interaction
        interaction_degs = os.path.join(OUTDIR, "{area}", "{area}_sex_diagnosis_interaction_DEGs.csv"),
        interaction_all = os.path.join(OUTDIR, "{area}", "{area}_sex_diagnosis_interaction_all_genes.csv"),
        interaction_rds = os.path.join(OUTDIR, "{area}", "{area}_sex_diagnosis_interaction_results.rds"),
        interaction_volcano = os.path.join(OUTDIR, "{area}", "{area}_interaction_volcano.png"),
        # Summary
        summary = os.path.join(OUTDIR, "{area}", "{area}_summary.csv"),
        session_info = os.path.join(OUTDIR, "{area}", "sessionInfo.txt")
    params:
        outdir = os.path.join(OUTDIR, "{area}"),
        brain_area = "{area}",
        padj = PADJ_THRESH,
        lfc = LFC_THRESH,
        cores = CORES
    log:
        os.path.join(OUTDIR, "logs", "{area}_deseq2.log")
    benchmark:
        os.path.join(OUTDIR, "benchmarks", "{area}_deseq2.txt")
    threads: CORES
    resources:
        mem_mb = 16000,
        runtime = 120  # 2 hours
    conda:
        "envs/deseq2.yaml"
    shell:
        """
        Rscript {input.script} \
            --counts {input.counts} \
            --metadata {input.metadata} \
            --outdir {params.outdir} \
            --brain_area {params.brain_area} \
            --padj {params.padj} \
            --lfc {params.lfc} \
            --cores {params.cores} \
            2>&1 | tee {log}
        """

# ==============================================================================
# DOWNSTREAM ANALYSIS RULES
# ==============================================================================

rule compare_contrasts:
    """
    Compare DEGs across the three contrasts for each brain area
    Identify genes that are:
      - Specific to males
      - Specific to females
      - Shared between sexes
      - Show sex-specific AD effects (interaction)
    """
    input:
        males = os.path.join(OUTDIR, "{area}", "{area}_males_AD_vs_control_DEGs.csv"),
        females = os.path.join(OUTDIR, "{area}", "{area}_females_AD_vs_control_DEGs.csv"),
        interaction = os.path.join(OUTDIR, "{area}", "{area}_sex_diagnosis_interaction_DEGs.csv")
    output:
        venn = os.path.join(OUTDIR, "{area}", "{area}_venn_diagram.png"),
        comparison = os.path.join(OUTDIR, "{area}", "{area}_contrast_comparison.csv"),
        upset = os.path.join(OUTDIR, "{area}", "{area}_upset_plot.png")
    params:
        outdir = os.path.join(OUTDIR, "{area}")
    log:
        os.path.join(OUTDIR, "logs", "{area}_compare.log")
    conda:
        "envs/deseq2.yaml"
    script:
        "scripts/compare_contrasts.R"

rule pathway_enrichment:
    """
    Pathway enrichment analysis for each contrast
    Uses GSEA with MSigDB hallmark gene sets
    """
    input:
        degs = os.path.join(OUTDIR, "{area}", "{area}_{contrast}_DEGs.csv"),
        all_genes = os.path.join(OUTDIR, "{area}", "{area}_{contrast}_all_genes.csv")
    output:
        enrichment = os.path.join(OUTDIR, "{area}", "enrichment", "{contrast}_enrichment.csv"),
        plot = os.path.join(OUTDIR, "{area}", "enrichment", "{contrast}_dotplot.png")
    params:
        contrast = "{contrast}"
    log:
        os.path.join(OUTDIR, "logs", "{area}_{contrast}_enrichment.log")
    conda:
        "envs/enrichment.yaml"
    script:
        "scripts/pathway_enrichment.R"

rule integrate_results:
    """
    Integrate results across all brain areas
    Create cross-area comparisons and meta-analysis
    """
    input:
        summaries = expand(os.path.join(OUTDIR, "{area}", "{area}_summary.csv"),
                          area=BRAIN_AREAS),
        males_degs = expand(os.path.join(OUTDIR, "{area}", "{area}_males_AD_vs_control_DEGs.csv"),
                           area=BRAIN_AREAS),
        females_degs = expand(os.path.join(OUTDIR, "{area}", "{area}_females_AD_vs_control_DEGs.csv"),
                             area=BRAIN_AREAS),
        interaction_degs = expand(os.path.join(OUTDIR, "{area}", "{area}_sex_diagnosis_interaction_DEGs.csv"),
                                 area=BRAIN_AREAS)
    output:
        integrated_summary = os.path.join(OUTDIR, "integrated_summary.csv"),
        shared_degs = os.path.join(OUTDIR, "shared_DEGs_across_areas.csv"),
        heatmap = os.path.join(OUTDIR, "cross_area_heatmap.png")
    params:
        areas = BRAIN_AREAS
    log:
        os.path.join(OUTDIR, "logs", "integration.log")
    conda:
        "envs/deseq2.yaml"
    script:
        "scripts/integrate_results.R"

rule generate_report:
    """
    Generate comprehensive HTML report with all results
    """
    input:
        integrated = os.path.join(OUTDIR, "integrated_summary.csv"),
        shared = os.path.join(OUTDIR, "shared_DEGs_across_areas.csv"),
        heatmap = os.path.join(OUTDIR, "cross_area_heatmap.png"),
        summaries = expand(os.path.join(OUTDIR, "{area}", "{area}_summary.csv"),
                          area=BRAIN_AREAS),
        volcanos_males = expand(os.path.join(OUTDIR, "{area}", "{area}_males_volcano.png"),
                               area=BRAIN_AREAS),
        volcanos_females = expand(os.path.join(OUTDIR, "{area}", "{area}_females_volcano.png"),
                                 area=BRAIN_AREAS),
        volcanos_interaction = expand(os.path.join(OUTDIR, "{area}", "{area}_interaction_volcano.png"),
                                     area=BRAIN_AREAS)
    output:
        report = os.path.join(OUTDIR, "final_report.html")
    params:
        title = "Sex-Stratified Differential Expression in Alzheimer's Disease",
        areas = BRAIN_AREAS
    log:
        os.path.join(OUTDIR, "logs", "report.log")
    conda:
        "envs/reporting.yaml"
    script:
        "scripts/generate_report.Rmd"

# ==============================================================================
# UTILITY RULES
# ==============================================================================

rule clean:
    """
    Remove all output files
    """
    shell:
        "rm -rf {OUTDIR}"

rule dag:
    """
    Generate DAG visualization of the workflow
    """
    output:
        "dag.pdf"
    shell:
        "snakemake --dag | dot -Tpdf > {output}"

rule dry_run:
    """
    Perform a dry run to check the workflow
    """
    shell:
        "snakemake -n"