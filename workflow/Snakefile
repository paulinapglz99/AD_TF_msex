# ---- 6. Expression matrices for the networks (ARACNe-AP) --------------------


# Corrected expression of each region: kept samples, genes expressed in all the
# groups, VST and removal of the DESeq2 covariates (protecting the groups),
# plus the PCA after the correction (tables)
rule network_qc:
    input:
        counts="results/counts/{region}/counts.rds",
        samples="results/sample_qc/{region}/samples_kept.tsv",
        factors="results/gc_normalize/{region}/normalization_factors.rds",
        gene_filter="workflow/scripts/R/gene_filter.R",
        expression_utils="workflow/scripts/R/expression_utils.R",
    output:
        expression="results/network_qc/{region}/expression.rds",
        scores="results/network_qc/{region}/pca_scores.tsv",
        variance="results/network_qc/{region}/pca_variance.tsv",
        association="results/network_qc/{region}/pca_covariate_association.tsv",
        distribution="results/network_qc/{region}/sample_distribution.tsv",
    log:
        "logs/network_qc/{region}.log",
    conda:
        "envs/deseq2.yaml"
    params:
        covariates=deseq2_covariates_of,
        min_cpm=config["gene_filter"]["min_cpm"],
        min_fraction=config["gene_filter"]["min_fraction"],
        top_genes=config["pca"]["top_genes"],
        n_pcs=config["pca"]["n_pcs"],
        pca_covariates=config["pca"]["covariates"],
    script:
        "scripts/network_qc.R"


