# ---- 06. Network comparison -------------------------------------------------


# The 4 networks of one region compared pair by pair (Jaccard of edges and
# nodes, Spearman of degree, NMI of communities) and convergence/divergence index
rule network_comparison:
    input:
        networks=expand(NETWORK, group=GROUPS, allow_missing=True),
        nodes=expand(NETNODES, group=GROUPS, allow_missing=True),
        samples=METADATA,
        network_utils="workflow/scripts/utils/network_utils.R",
    output:
        pairs=NETPAIRS,
        convergence=CONVERGENCE,
    log:
        "logs/network_analysis/{cohort}_{region}/comparison.log",
    conda:
        "envs/network_analysis.yaml"
    params:
        groups=GROUPS,
    script:
        "scripts/06_network_comparison/network_comparison.R"


# Rewiring of every gene by AD in women and in men, and rewired genes x DEGs
rule gene_rewiring:
    input:
        networks=expand(NETWORK, group=GROUPS, allow_missing=True),
        regulators=REGULATORS,
        de_female=of_contrast(DEGS, "female_contrast"),
        de_male=of_contrast(DEGS, "male_contrast"),
        de_interaction=of_contrast(DEGS, "interaction_contrast"),
        network_utils="workflow/scripts/utils/network_utils.R",
        overlap_utils="workflow/scripts/utils/overlap_utils.R",
    output:
        genes=REWIRING,
        tests=REWIRINGVSDEG,
    log:
        "logs/network_analysis/{cohort}_{region}/gene_rewiring.log",
    conda:
        "envs/network_analysis.yaml"
    params:
        groups=GROUPS,
        min_degree=config["network_analysis"]["rewiring"]["min_degree"],
        top_rewired=config["network_analysis"]["rewiring"]["top_rewired"],
        sensitivity=config["network_analysis"]["rewiring"]["sensitivity"],
        n_perm=config["network_analysis"]["rewiring"]["n_perm"],
        strata=config["network_analysis"]["rewiring"]["strata"],
        seed=config["network_analysis"]["rewiring"]["seed"],
    script:
        "scripts/06_network_comparison/gene_rewiring.R"


# Function of the genes rewired in women only, in men only and in both
rule rewiring_enrichment:
    input:
        genes=REWIRING,
