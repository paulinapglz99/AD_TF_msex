import pandas as pd
from snakemake.utils import min_version

min_version("9.0")


configfile: "config/config.yaml"


# Synapse token is read from this environment variable (never written in the repo)
envvars:
    "SYNAPSE_AUTH_TOKEN",


# ---- Tables from config/ ----------------------------------------------------

# Brain regions: region, study, tissue (value of the 'tissue' column in the metadata)
REGIONS = pd.read_csv(config["samples"], sep="\t", dtype=str).set_index(
    "region", drop=False
)

# Cohort of each region, as written in the file names (ROSMAP, MAYO)
COHORT = REGIONS["study"].str.upper().to_dict()

# Files to download. Columns: syn_id, version, category, filename, description
FILES = pd.read_csv(config["synapse_files"], sep="\t", dtype=str)


def counts_of(wildcards):
    """Raw count matrices of the region's study (4 batches for ROSMAP, 1 for Mayo)"""
    study = REGIONS.loc[wildcards.region, "study"]
    files = FILES.loc[
        (FILES["category"] == "data") & (FILES["study"] == study), "filename"
    ]
    return expand("resources/data/{filename}", filename=files)


def covariates_of(wildcards):
    """Sage's covariates (with the harmonized diagnosis) of the region's study"""
    study = REGIONS.loc[wildcards.region, "study"]
    return f"resources/metadata/{study}_Covariates_ages_censored.tsv"


def deseq2_covariates_of(wildcards):
    """Covariates of the DESeq2 model for the region's study (config.yaml)"""
    study = REGIONS.loc[wildcards.region, "study"]
    return config["deseq2"]["covariates"][study]


def metadata_of(wildcards):
    """Original metadata of the region's study (library prep, kit, read length)"""
    study = REGIONS.loc[wildcards.region, "study"]
    return f"resources/metadata/RNAseq_Harmonization_{study}_combined_metadata.csv"


# Names of the DESeq2 contrasts, e.g. ADvsCT_female
CONTRASTS = list(config["deseq2"]["contrasts"])

# Groups of samples (diagnosis x sex), e.g. AD_female: one network each
GROUPS = [f"{dx}_{sex}" for dx in config["diagnoses"] for sex in ["female", "male"]]


wildcard_constraints:
    category="|".join(sorted(set(FILES["category"]))),
    filename=r"[^/]+",
    cohort="|".join(sorted(set(COHORT.values()))),
    region="|".join(REGIONS.index),
    contrast="|".join(CONTRASTS),
    group="|".join(GROUPS),
    seed=r"\d+",


# ---- Result files -----------------------------------------------------------
# results/<step>/<region>/<experiment>_<cohort>_<region>[_<diagnosis>_<sex>].<ext>
# One folder per step of the pipeline (numbered like workflow/scripts/) and one
# per region inside it. "_all" = every group of the region; a contrast name
# (ADvsCT_female...) instead of the group in the differential expression files.

# 02. Preprocessing
# counts of the AD/CT samples
RAWCOUNTS = "results/02_preprocessing/{region}/rawcounts_{cohort}_{region}.rds"
# their metadata
RAWMETADATA = "results/02_preprocessing/{region}/rawmetadata_{cohort}_{region}.tsv"
# GC/length normalization factors
GCFACTORS = "results/02_preprocessing/{region}/gcFactors_{cohort}_{region}.rds"
# GC/length bias before and after
GCBIAS = "results/02_preprocessing/{region}/gcBias_{cohort}_{region}.tsv"
PCAPRE_SCORES = "results/02_preprocessing/{region}/pcaPreScores_{cohort}_{region}.tsv"
PCAPRE_VARIANCE = "results/02_preprocessing/{region}/pcaPreVariance_{cohort}_{region}.tsv"
PCAPRE_COVARIATES = "results/02_preprocessing/{region}/pcaPreCovariates_{cohort}_{region}.tsv"
# QC of every sample (outliers)
SAMPLEQC = "results/02_preprocessing/{region}/sampleQC_{cohort}_{region}_all.tsv"
# samples kept after the QC
METADATA = "results/02_preprocessing/{region}/metadata_{cohort}_{region}_all.tsv"

# 03. Differential expression
DDS = "results/03_differential_expression/{region}/dds_{cohort}_{region}.rds"
DEGS = "results/03_differential_expression/{region}/degs_{cohort}_{region}_{contrast}.tsv"
DEGSUMMARY = "results/03_differential_expression/{region}/degSummary_{cohort}_{region}.tsv"
GSEA = "results/03_differential_expression/{region}/gsea_{cohort}_{region}_{contrast}.tsv"

# 04. Network inference
# corrected expression
MATRIX_ALL = "results/04_network_inference/{region}/matrizQC_{cohort}_{region}_all.rds"
PCAPOST_SCORES = "results/04_network_inference/{region}/pcaPostScores_{cohort}_{region}.tsv"
PCAPOST_VARIANCE = "results/04_network_inference/{region}/pcaPostVariance_{cohort}_{region}.tsv"
PCAPOST_COVARIATES = "results/04_network_inference/{region}/pcaPostCovariates_{cohort}_{region}.tsv"
SAMPLEDIST = "results/04_network_inference/{region}/sampleDist_{cohort}_{region}.tsv"
# input of ARACNe-AP
MATRIX = "results/04_network_inference/{region}/matrizQC_{cohort}_{region}_{group}.tsv"
METADATA_GROUP = "results/04_network_inference/{region}/metadata_{cohort}_{region}_{group}.tsv"
REGULATORS = "results/04_network_inference/{region}/regulators_{cohort}_{region}.txt"
NETWORK = "results/04_network_inference/{region}/coexprnet_{cohort}_{region}_{group}.tsv"

# 05. Network topology
NETMETRICS = "results/05_network_topology/{region}/netMetrics_{cohort}_{region}_{group}.tsv"
NETNODES = "results/05_network_topology/{region}/netNodes_{cohort}_{region}_{group}.tsv"
COMMENRICH = "results/05_network_topology/{region}/commEnrich_{cohort}_{region}_{group}.tsv"

# 06. Network comparison
NETPAIRS = "results/06_network_comparison/{region}/netPairs_{cohort}_{region}.tsv"
CONVERGENCE = "results/06_network_comparison/{region}/convergence_{cohort}_{region}.tsv"
REWIRING = "results/06_network_comparison/{region}/rewiring_{cohort}_{region}.tsv"
REWIRINGVSDEG = "results/06_network_comparison/{region}/rewiringVsDEG_{cohort}_{region}.tsv"
REWIRINGENRICH = "results/06_network_comparison/{region}/rewiringEnrich_{cohort}_{region}.tsv"

THEME = "workflow/scripts/utils/theme_pub.R"


def per_region(pattern, **wildcards):
    """The file of every region (with its cohort), in the order of samples.tsv"""
    return [
        path
        for region in REGIONS.index
        for path in expand(pattern, region=region, cohort=COHORT[region], **wildcards)
    ]


def of_contrast(pattern, name):
    """A per-region pattern with one contrast of config.yaml (figures/<name>)"""
    return pattern.replace("{contrast}", config["figures"][name])


rule all:
    default_target: True
    input:
        collect(
            "resources/{category}/{filename}",
            zip,
            category=FILES["category"],
            filename=FILES["filename"],
        ),
        "results/plots/supplementary/metadata_panel.pdf",
        "results/plots/supplementary/pca_pre_panel.pdf",
        per_region(DEGSUMMARY),
        per_region(GSEA, contrast=CONTRASTS),
        "results/plots/main/degs_ad_by_sex.pdf",
        "results/plots/supplementary/de_panel.pdf",
        "results/plots/supplementary/pathways_by_sex.pdf",
        "results/plots/supplementary/pca_post_panel.pdf",
        "results/plots/supplementary/sample_qc_panel.pdf",
        per_region(MATRIX, group=GROUPS),


# ---- 00. Download count matrices and metadata from Synapse ------------------


rule download_synapse:
    output:
        protected("resources/{category}/{filename}"),
    log:
        "logs/download_synapse/{category}/{filename}.log",
    conda:
        "envs/synapse.yaml"
    params:
        syn_id=lookup(
            query="category == '{category}' & filename == '{filename}'",
            within=FILES,
            cols="syn_id",
        ),
        version=lookup(
            query="category == '{category}' & filename == '{filename}'",
            within=FILES,
            cols="version",
        ),
    shell:
        "synapse get {params.syn_id} --version {params.version} "
        "--downloadLocation resources/{wildcards.category} > {log:q} 2>&1"


# ---- 01. Metadata -----------------------------------------------------------


# Supplementary panel: samples per group, sex proportion, age/PMI/RIN, XIST vs UTY
rule plot_metadata:
    input:
        regions=config["samples"],
        rosmap_covariates="resources/metadata/ROSMAP_Covariates_ages_censored.tsv",
        mayo_covariates="resources/metadata/Mayo_Covariates_ages_censored.tsv",
        rosmap_counts=collect(
            "resources/data/ROSMAP_batch{batch}_gene_all_counts_matrix_clean.txt",
            batch=[1, 2, 3, 4],
        ),
        mayo_counts="resources/data/Mayo_gene_all_counts_matrix_clean.txt",
        theme=THEME,
    output:
        pdf="results/plots/supplementary/metadata_panel.pdf",
        jpeg="results/plots/supplementary/metadata_panel.jpeg",
    log:
        "logs/plot_metadata.log",
    conda:
        "envs/plots_r.yaml"
    params:
        diagnoses=config["diagnoses"],
    script:
        "scripts/01_metadata/plot_metadata.R"


# ---- 02. Preprocessing ------------------------------------------------------


# AD/CT samples of one region, one per individual, with their raw counts.
# Shared by the differential expression and the network branches.
rule prepare_counts:
    input:
        counts=counts_of,
        covariates=covariates_of,
        metadata=metadata_of,
        regions=config["samples"],
    output:
        counts=RAWCOUNTS,
        samples=RAWMETADATA,
    log:
        "logs/prepare_counts/{cohort}_{region}.log",
    conda:
        "envs/r_tidy.yaml"
    params:
        diagnoses=config["diagnoses"],
        min_batch_size=config["min_batch_size"],
    script:
        "scripts/02_preprocessing/prepare_counts.R"


# GC content and length of every gene, from a fixed Ensembl archive (BioMart).
# Needs internet only when it runs (once).
rule gene_annotation:
    output:
        config["annotation"]["file"],
    log:
        "logs/gene_annotation.log",
    conda:
        "envs/annotation.yaml"
    params:
        host=config["annotation"]["ensembl_host"],
    script:
        "scripts/02_preprocessing/gene_annotation.R"


# GC and length correction of each region (EDASeq) as normalization factors,
# with NOISeq diagnostics of both biases before and after. Used by sample_qc,
# deseq2 and network_qc.
rule gc_normalize:
    input:
        counts=RAWCOUNTS,
        samples=RAWMETADATA,
        annotation=config["annotation"]["file"],
        gene_filter="workflow/scripts/utils/gene_filter.R",
    output:
        factors=GCFACTORS,
        bias=GCBIAS,
    log:
        "logs/gc_normalize/{cohort}_{region}.log",
    conda:
        "envs/deseq2.yaml"
    params:
        min_cpm=config["gene_filter"]["min_cpm"],
        min_fraction=config["gene_filter"]["min_fraction"],
    script:
        "scripts/02_preprocessing/gc_normalize.R"


# PCA of each region before any correction, and variance of each PC explained
# by each covariate, to choose the covariates of the DESeq2 model (tables only)
rule pca_pre:
    input:
        counts=RAWCOUNTS,
        samples=RAWMETADATA,
        gene_filter="workflow/scripts/utils/gene_filter.R",
        expression_utils="workflow/scripts/utils/expression_utils.R",
    output:
        scores=PCAPRE_SCORES,
        variance=PCAPRE_VARIANCE,
        association=PCAPRE_COVARIATES,
    log:
        "logs/pca_pre/{cohort}_{region}.log",
    conda:
        "envs/deseq2.yaml"
    params:
        min_cpm=config["gene_filter"]["min_cpm"],
        min_fraction=config["gene_filter"]["min_fraction"],
        top_genes=config["pca"]["top_genes"],
        n_pcs=config["pca"]["n_pcs"],
        covariates=config["pca"]["covariates"],
    script:
        "scripts/02_preprocessing/pca_pre.R"


# Supplementary panel with the PCA of every region, one row per region
rule plot_pca_pre:
    input:
        scores=per_region(PCAPRE_SCORES),
        variance=per_region(PCAPRE_VARIANCE),
        association=per_region(PCAPRE_COVARIATES),
        regions=config["samples"],
        theme=THEME,
    output:
        pdf="results/plots/supplementary/pca_pre_panel.pdf",
        jpeg="results/plots/supplementary/pca_pre_panel.jpeg",
    log:
        "logs/plot_pca_pre.log",
    conda:
        "envs/plots_r.yaml"
    params:
        covariates=config["pca"]["covariates"],
    script:
        "scripts/02_preprocessing/plot_pca.R"


# Outlier samples of each region (standardized connectivity, sex check). The
# kept samples are used by both branches: differential expression and networks.
rule sample_qc:
    input:
        counts=RAWCOUNTS,
        samples=RAWMETADATA,
        factors=GCFACTORS,
        gene_filter="workflow/scripts/utils/gene_filter.R",
        expression_utils="workflow/scripts/utils/expression_utils.R",
    output:
        qc=SAMPLEQC,
        kept=METADATA,
    log:
        "logs/sample_qc/{cohort}_{region}.log",
    conda:
        "envs/deseq2.yaml"
    params:
        covariates=deseq2_covariates_of,
        min_cpm=config["gene_filter"]["min_cpm"],
        min_fraction=config["gene_filter"]["min_fraction"],
        max_connectivity_z=config["sample_qc"]["max_connectivity_z"],
        check_sex=config["sample_qc"]["check_sex"],
    script:
        "scripts/02_preprocessing/sample_qc.R"


# ---- 03. Differential expression --------------------------------------------


# One DESeq2 model per region (~ covariates + group, group = diagnosis_sex);
# every contrast of config.yaml comes from that same fit
rule deseq2:
    input:
        counts=RAWCOUNTS,
        samples=METADATA,
        factors=GCFACTORS,
        gene_filter="workflow/scripts/utils/gene_filter.R",
        expression_utils="workflow/scripts/utils/expression_utils.R",
    output:
        dds=DDS,
        tables=expand(DEGS, contrast=CONTRASTS, allow_missing=True),
        summary=DEGSUMMARY,
    log:
        "logs/deseq2/{cohort}_{region}.log",
    conda:
        "envs/deseq2.yaml"
    threads: 4
    params:
        covariates=deseq2_covariates_of,
        contrasts=config["deseq2"]["contrasts"],
        padj=config["deseq2"]["padj"],
        log2fc=config["deseq2"]["log2fc"],
        min_cpm=config["gene_filter"]["min_cpm"],
        min_fraction=config["gene_filter"]["min_fraction"],
    script:
        "scripts/03_differential_expression/deseq2.R"


# GSEA of one DESeq2 contrast: GO biological process and Reactome
rule gsea:
    input:
        table=DEGS,
    output:
        GSEA,
    log:
        "logs/gsea/{cohort}_{region}/{contrast}.log",
    conda:
        "envs/gsea.yaml"
    params:
        min_size=config["gsea"]["min_size"],
        max_size=config["gsea"]["max_size"],
        seed=config["gsea"]["seed"],
    script:
        "scripts/03_differential_expression/gsea.R"


# Main figure: (a) DEGs per sex, (b) log2FC of AD in women vs in men,
# (c) NES of AD in women vs in men, colored by the interaction
rule plot_degs_ad_by_sex:
    input:
        de_female=per_region(of_contrast(DEGS, "female_contrast")),
        de_male=per_region(of_contrast(DEGS, "male_contrast")),
        gsea_female=per_region(of_contrast(GSEA, "female_contrast")),
        gsea_male=per_region(of_contrast(GSEA, "male_contrast")),
        gsea_interaction=per_region(of_contrast(GSEA, "interaction_contrast")),
        samples=per_region(METADATA),
        regions=config["samples"],
        theme=THEME,
    output:
        pdf="results/plots/main/degs_ad_by_sex.pdf",
        jpeg="results/plots/main/degs_ad_by_sex.jpeg",
    log:
        "logs/plot_degs_ad_by_sex.log",
    conda:
        "envs/plots_r.yaml"
    params:
        collection=config["figures"]["pathways"]["collection"],
        padj=config["figures"]["pathways"]["padj"],
    script:
        "scripts/03_differential_expression/plot_degs_ad_by_sex.R"


# Supplementary figure of the differential expression: (a) volcanos AD vs CT per
# sex, (b) volcanos of the interaction, (c) correlation of the AD effect between
# regions and sexes, (d) top pathways of the interaction
rule plot_de_supplementary:
    input:
        de_female=per_region(of_contrast(DEGS, "female_contrast")),
        de_male=per_region(of_contrast(DEGS, "male_contrast")),
        de_interaction=per_region(of_contrast(DEGS, "interaction_contrast")),
        gsea_interaction=per_region(of_contrast(GSEA, "interaction_contrast")),
        regions=config["samples"],
        theme=THEME,
    output:
        pdf="results/plots/supplementary/de_panel.pdf",
        jpeg="results/plots/supplementary/de_panel.jpeg",
    log:
        "logs/plot_de_supplementary.log",
    conda:
        "envs/plots_r.yaml"
    params:
        collection=config["figures"]["pathways"]["collection"],
        top_n=config["figures"]["pathways"]["top_n"],
        padj=config["figures"]["pathways"]["padj"],
        log2fc=config["deseq2"]["log2fc"],
    script:
        "scripts/03_differential_expression/plot_de_supplementary.R"


# Supplementary: top pathways of AD in women and in men, one panel per collection
rule plot_pathways_by_sex:
    input:
        gsea_female=per_region(of_contrast(GSEA, "female_contrast")),
        gsea_male=per_region(of_contrast(GSEA, "male_contrast")),
        regions=config["samples"],
        theme=THEME,
    output:
        pdf="results/plots/supplementary/pathways_by_sex.pdf",
        jpeg="results/plots/supplementary/pathways_by_sex.jpeg",
    log:
        "logs/plot_pathways_by_sex.log",
    conda:
        "envs/plots_r.yaml"
    params:
        collections=config["figures"]["pathways"]["supplementary_collections"],
        top_n=config["figures"]["pathways"]["top_n"],
        padj=config["figures"]["pathways"]["padj"],
    script:
        "scripts/03_differential_expression/plot_pathways_by_sex.R"


# ---- 04. Network inference (ARACNe-AP) --------------------------------------


# Corrected expression of each region: kept samples, genes expressed in all the
# groups, VST and removal of the DESeq2 covariates (protecting the groups),
# plus the PCA after the correction (tables)
rule network_qc:
    input:
        counts=RAWCOUNTS,
        samples=METADATA,
        factors=GCFACTORS,
        gene_filter="workflow/scripts/utils/gene_filter.R",
        expression_utils="workflow/scripts/utils/expression_utils.R",
    output:
        expression=MATRIX_ALL,
        scores=PCAPOST_SCORES,
        variance=PCAPOST_VARIANCE,
        association=PCAPOST_COVARIATES,
        distribution=SAMPLEDIST,
    log:
        "logs/network_qc/{cohort}_{region}.log",
    conda:
        "envs/deseq2.yaml"
    params:
        covariates=deseq2_covariates_of,
        min_cpm=config["gene_filter"]["min_cpm"],
        min_fraction=config["gene_filter"]["min_fraction"],
        top_genes=config["pca"]["top_genes"],
        n_pcs=config["pca"]["n_pcs"],
        pca_covariates=config["pca"]["covariates"],
    script:
        "scripts/04_network_inference/network_qc.R"


# Supplementary panel with the PCA of every region after the correction
rule plot_pca_post:
    input:
        scores=per_region(PCAPOST_SCORES),
        variance=per_region(PCAPOST_VARIANCE),
        association=per_region(PCAPOST_COVARIATES),
        regions=config["samples"],
        theme=THEME,
    output:
        pdf="results/plots/supplementary/pca_post_panel.pdf",
        jpeg="results/plots/supplementary/pca_post_panel.jpeg",
    log:
        "logs/plot_pca_post.log",
    conda:
        "envs/plots_r.yaml"
    params:
        covariates=config["pca"]["covariates"],
    script:
        "scripts/02_preprocessing/plot_pca.R"


# Supplementary panel of sample QC: library size, detected genes, connectivity
# (outliers) and distribution of every sample before and after the correction
rule plot_sample_qc:
    input:
        sample_qc=per_region(SAMPLEQC),
        distribution=per_region(SAMPLEDIST),
        bias=per_region(GCBIAS),
        regions=config["samples"],
        theme=THEME,
    output:
        pdf="results/plots/supplementary/sample_qc_panel.pdf",
        jpeg="results/plots/supplementary/sample_qc_panel.jpeg",
    log:
        "logs/plot_sample_qc.log",
    conda:
        "envs/plots_r.yaml"
    params:
        max_connectivity_z=config["sample_qc"]["max_connectivity_z"],
    script:
        "scripts/04_network_inference/plot_sample_qc.R"


# One expression matrix per group (diagnosis x sex), the input of ARACNe-AP,
# and the metadata of the samples of each group
rule split_groups:
    input:
        expression=MATRIX_ALL,
        samples=METADATA,
    output:
        matrices=expand(MATRIX, group=GROUPS, allow_missing=True),
        metadata=expand(METADATA_GROUP, group=GROUPS, allow_missing=True),
    log:
        "logs/split_groups/{cohort}_{region}.log",
    conda:
        "envs/r_tidy.yaml"
    params:
        groups=GROUPS,
    script:
        "scripts/04_network_inference/split_groups.R"


# Download ARACNe-AP at a fixed commit and build the jar (JDK + ant)
rule install_aracne:
    output:
        config["aracne"]["jar"],
    log:
        "logs/install_aracne.log",
    conda:
        "envs/aracne.yaml"
    params:
        commit=config["aracne"]["commit"],
        src="resources/aracne/ARACNe-AP",
    shell:
        """
        rm -rf {params.src} && mkdir -p {params.src}
        curl -sL https://github.com/califano-lab/ARACNe-AP/archive/{params.commit}.tar.gz \
            | tar -xz --strip-components=1 -C {params.src}
        (cd {params.src} && ant main) >{log} 2>&1
        cp {params.src}/dist/aracne.jar {output}
        """


# Regulators of the networks of one region: every gene of its matrices (the
# 4 groups of a region share the same genes, so one list per region)
rule aracne_regulators:
    input:
        MATRIX.replace("{group}", GROUPS[0]),
    output:
        REGULATORS,
    log:
        "logs/aracne/{cohort}_{region}/regulators.log",
    conda:
        "envs/aracne.yaml"
    shell:
        "tail -n +2 {input:q} | cut -f1 > {output:q} 2> {log:q}"


# ARACNe-AP. Step 1: MI threshold. Output: folder with miThreshold_p<pvalue>_samples<N>.txt
rule aracne_threshold:
    input:
        matrix=MATRIX,
        regulators=REGULATORS,
        # ancient(): rebuilding the jar must not make the networks rerun
        jar=ancient(config["aracne"]["jar"]),
    output:
        directory("results/04_network_inference/{region}/aracne_{cohort}_{region}_{group}/threshold"),
    log:
        "logs/aracne/{cohort}_{region}/{group}/threshold.log",
    conda:
        "envs/aracne.yaml"
    resources:
        mem_gb=config["aracne"]["memory"]["threshold_gb"],
    params:
        pvalue=config["aracne"]["pvalue"],
    shell:
        """
        mkdir -p {output}
        java -Xmx{resources.mem_gb}G -jar {input.jar} \
            -e {input.matrix} -o {output} --tfs {input.regulators} \
            --pvalue {params.pvalue} --seed 1 --calculateThreshold \
            &>{log}
        """


# ARACNe-AP. Step 2: one bootstrap per seed
rule aracne_bootstrap:
    input:
        matrix=MATRIX,
        regulators=REGULATORS,
        threshold="results/04_network_inference/{region}/aracne_{cohort}_{region}_{group}/threshold",
        # ancient(): rebuilding the jar must not make the networks rerun
        jar=ancient(config["aracne"]["jar"]),
    output:
        # ARACNe's working folder for this seed. After the mv it only holds a copy of
        # the threshold file, so temp() lets Snakemake delete it when the job ends
        work=temp(directory("results/04_network_inference/{region}/aracne_{cohort}_{region}_{group}/bootstraps/seed{seed}")),
        # ARACNe names its output with a random ID; we rename it with the seed so the
        # name is known in advance and the consolidate step can request it by expand.
        # temp(): deleted once the network is consolidated
        network=temp("results/04_network_inference/{region}/aracne_{cohort}_{region}_{group}/bootstrap_networks/bootstrapNetwork_seed{seed}.txt"),
    log:
        "logs/aracne/{cohort}_{region}/{group}/bootstrap_seed{seed}.log",
    conda:
        "envs/aracne.yaml"
    threads: config["aracne"]["bootstrap"]["threads"]
    resources:
        mem_gb=config["aracne"]["memory"]["bootstrap_gb"],
    params:
        pvalue=config["aracne"]["pvalue"],
    shell:
        """
        mkdir -p {output.work}
        # ARACNe looks for the threshold file inside -o, so it must be copied there
        cp {input.threshold}/miThreshold_*.txt {output.work}/
        # Java heap 2 GB below the job's memory: the JVM uses memory outside the heap
        java -Xmx$(({resources.mem_gb} - 2))G -jar {input.jar} \
            -e {input.matrix} -o {output.work} --tfs {input.regulators} \
            --pvalue {params.pvalue} --threads {threads} --seed {wildcards.seed} \
            &>{log}
        # Each run writes exactly one bootstrapNetwork_*.txt; give it its fixed name
        mv {output.work}/bootstrapNetwork_*.txt {output.network}
        """


# ARACNe-AP. Step 3: consolidate the bootstraps (edges kept at p < 0.05)
rule aracne_consolidate:
    input:
        # One file per seed, already together in bootstrap_networks/
        bootstraps=expand(
            "results/04_network_inference/{region}/aracne_{cohort}_{region}_{group}/bootstrap_networks/bootstrapNetwork_seed{seed}.txt",
            # int(): a value given with --config arrives as text
            seed=range(1, int(config["aracne"]["bootstrap"]["n_boot"]) + 1),
            allow_missing=True,
        ),
        # ancient(): rebuilding the jar must not make the networks rerun
        jar=ancient(config["aracne"]["jar"]),
    output:
        # ARACNe writes network.txt inside the folder it consolidates.
        # temp(): it is an identical copy of the final network below
        consolidated=temp("results/04_network_inference/{region}/aracne_{cohort}_{region}_{group}/bootstrap_networks/network.txt"),
        # Final network (kept): Regulator, Target, MI, pvalue
        network=NETWORK,
    log:
        "logs/aracne/{cohort}_{region}/{group}/consolidate.log",
    conda:
        "envs/aracne.yaml"
    resources:
        mem_gb=config["aracne"]["memory"]["consolidate_gb"],
    shell:
        """
        java -Xmx$(({resources.mem_gb} - 2))G -jar {input.jar} \
            -o $(dirname {output.consolidated}) --consolidate &>{log}
        cp {output.consolidated} {output.network}
        """


# ---- 05. Network topology ---------------------------------------------------


# Topology of one network, and degree, PageRank and Leiden community of its genes
rule network_metrics:
    input:
        network=NETWORK,
        network_utils="workflow/scripts/utils/network_utils.R",
    output:
        metrics=NETMETRICS,
        nodes=NETNODES,
    log:
        "logs/network_analysis/{cohort}_{region}/{group}/metrics.log",
