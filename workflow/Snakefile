        gsea_male=collect(
            "results/gsea/{region}/{contrast}.tsv",
            region=REGIONS.index,
            contrast=config["figures"]["male_contrast"],
        ),
        gsea_interaction=collect(
            "results/gsea/{region}/{contrast}.tsv",
            region=REGIONS.index,
            contrast=config["figures"]["interaction_contrast"],
        ),
        samples=collect(
            "results/sample_qc/{region}/samples_kept.tsv", region=REGIONS.index
        ),
