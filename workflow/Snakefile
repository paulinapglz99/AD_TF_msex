# One expression matrix per group (diagnosis x sex), the input of ARACNe-AP
rule split_groups:
    input:
        expression="results/network_qc/{region}/expression.rds",
        samples="results/sample_qc/{region}/samples_kept.tsv",
    output:
        matrices=expand("results/network_input/{{region}}/{group}.tsv", group=GROUPS),
    log:
        "logs/split_groups/{region}.log",
    conda:
        "envs/r_tidy.yaml"
    params:
        groups=GROUPS,
    script:
        "scripts/split_groups.R"


# ---- 7. Networks with ARACNe-AP ---------------------------------------------


# Download ARACNe-AP at a fixed commit and build the jar (JDK + ant)
rule install_aracne:
    output:
        config["aracne"]["jar"],
    log:
        "logs/install_aracne.log",
    conda:
        "envs/aracne.yaml"
    params:
        commit=config["aracne"]["commit"],
        src="resources/aracne/ARACNe-AP",
    shell:
        """
        rm -rf {params.src} && mkdir -p {params.src}
        curl -sL https://github.com/califano-lab/ARACNe-AP/archive/{params.commit}.tar.gz \
            | tar -xz --strip-components=1 -C {params.src}
        (cd {params.src} && ant main) >{log} 2>&1
        cp {params.src}/dist/aracne.jar {output}
        """


# Regulators of the networks of one region: every gene of its matrices (the
# 4 groups of a region share the same genes, so one list per region)
rule aracne_regulators:
    input:
        f"results/network_input/{{region}}/{GROUPS[0]}.tsv",
    output:
        "results/aracne/{region}/regulators.txt",
    log:
        "logs/aracne/{region}/regulators.log",
    conda:
        "envs/aracne.yaml"
    shell:
        "tail -n +2 {input:q} | cut -f1 > {output:q} 2> {log:q}"


# ARACNe-AP. Step 1: MI threshold. Output: folder with miThreshold_p<pvalue>_samples<N>.txt
rule aracne_threshold:
    input:
        matrix="results/network_input/{region}/{group}.tsv",
        regulators="results/aracne/{region}/regulators.txt",
        # ancient(): rebuilding the jar must not make the networks rerun
        jar=ancient(config["aracne"]["jar"]),
    output:
        directory("results/aracne/{region}/{group}/threshold"),
    log:
        "logs/aracne/{region}/{group}/threshold.log",
    conda:
        "envs/aracne.yaml"
    resources:
        mem_gb=config["aracne"]["memory"]["threshold_gb"],
    params:
        pvalue=config["aracne"]["pvalue"],
    shell:
        """
        mkdir -p {output}
        java -Xmx{resources.mem_gb}G -jar {input.jar} \
            -e {input.matrix} -o {output} --tfs {input.regulators} \
            --pvalue {params.pvalue} --seed 1 --calculateThreshold \
            &>{log}
        """


# ARACNe-AP. Step 2: one bootstrap per seed
rule aracne_bootstrap:
    input:
        matrix="results/network_input/{region}/{group}.tsv",
        regulators="results/aracne/{region}/regulators.txt",
        threshold="results/aracne/{region}/{group}/threshold",
        # ancient(): rebuilding the jar must not make the networks rerun
        jar=ancient(config["aracne"]["jar"]),
    output:
        # ARACNe's working folder for this seed. After the mv it only holds a copy of
        # the threshold file, so temp() lets Snakemake delete it when the job ends
        work=temp(directory("results/aracne/{region}/{group}/bootstraps/seed{seed}")),
        # ARACNe names its output with a random ID; we rename it with the seed so the
        # name is known in advance and the consolidate step can request it by expand.
        # temp(): deleted once the network is consolidated
        network=temp(
            "results/aracne/{region}/{group}/bootstrap_networks/bootstrapNetwork_seed{seed}.txt"
        ),
    log:
        "logs/aracne/{region}/{group}/bootstrap_seed{seed}.log",
    conda:
        "envs/aracne.yaml"
    threads: config["aracne"]["bootstrap"]["threads"]
    resources:
        mem_gb=config["aracne"]["memory"]["bootstrap_gb"],
    params:
        pvalue=config["aracne"]["pvalue"],
    shell:
        """
        mkdir -p {output.work}
        # ARACNe looks for the threshold file inside -o, so it must be copied there
        cp {input.threshold}/miThreshold_*.txt {output.work}/
        # Java heap 2 GB below the job's memory: the JVM uses memory outside the heap
        java -Xmx$(({resources.mem_gb} - 2))G -jar {input.jar} \
            -e {input.matrix} -o {output.work} --tfs {input.regulators} \
            --pvalue {params.pvalue} --threads {threads} --seed {wildcards.seed} \
            &>{log}
        # Each run writes exactly one bootstrapNetwork_*.txt; give it its fixed name
        mv {output.work}/bootstrapNetwork_*.txt {output.network}
        """


# ARACNe-AP. Step 3: consolidate the bootstraps (edges kept at p < 0.05)
rule aracne_consolidate:
    input:
        # One file per seed, already together in bootstrap_networks/
        bootstraps=expand(
            "results/aracne/{{region}}/{{group}}/bootstrap_networks/bootstrapNetwork_seed{seed}.txt",
            # int(): a value given with --config arrives as text
            seed=range(1, int(config["aracne"]["bootstrap"]["n_boot"]) + 1),
        ),
        # ancient(): rebuilding the jar must not make the networks rerun
        jar=ancient(config["aracne"]["jar"]),
    output:
        # ARACNe writes network.txt inside the folder it consolidates.
        # temp(): it is an identical copy of the final network below
        consolidated=temp(
            "results/aracne/{region}/{group}/bootstrap_networks/network.txt"
        ),
        # Final network (kept)
        network="results/aracne/{region}/{group}/network.txt",
    log:
        "logs/aracne/{region}/{group}/consolidate.log",
    conda:
        "envs/aracne.yaml"
    resources:
        mem_gb=config["aracne"]["memory"]["consolidate_gb"],
    shell:
        """
        java -Xmx$(({resources.mem_gb} - 2))G -jar {input.jar} \
            -o $(dirname {output.consolidated}) --consolidate &>{log}
        cp {output.consolidated} {output.network}
        """


# ---- 8. Analysis of the networks --------------------------------------------


# Topology of one network, and degree, PageRank and Leiden community of its genes
rule network_metrics:
    input:
        network="results/aracne/{region}/{group}/network.txt",
        network_utils="workflow/scripts/R/network_utils.R",
    output:
        metrics="results/network_analysis/{region}/{group}/metrics.tsv",
        nodes="results/network_analysis/{region}/{group}/nodes.tsv",
    log:
        "logs/network_analysis/{region}/{group}/metrics.log",
    conda:
        "envs/network_analysis.yaml"
    params:
        resolution=config["network_analysis"]["communities"]["resolution"],
        seed=config["network_analysis"]["communities"]["seed"],
    script:
        "scripts/network_metrics.R"


# GO BP and Reactome over-representation in every community of one network
rule community_enrichment:
    input:
        nodes="results/network_analysis/{region}/{group}/nodes.tsv",
    output:
        "results/network_analysis/{region}/{group}/community_enrichment.tsv",
    log:
        "logs/network_analysis/{region}/{group}/community_enrichment.log",
    conda:
        "envs/gsea.yaml"
    params:
        min_community_size=config["network_analysis"]["community_enrichment"][
            "min_community_size"
        ],
        min_size=config["network_analysis"]["community_enrichment"]["min_size"],
        max_size=config["network_analysis"]["community_enrichment"]["max_size"],
        padj=config["network_analysis"]["community_enrichment"]["padj"],
    script:
        "scripts/community_enrichment.R"


# The 4 networks of one region compared pair by pair (Jaccard of edges and
# nodes, Spearman of degree, NMI of communities) and convergence/divergence index
rule network_comparison:
    input:
        networks=expand("results/aracne/{{region}}/{group}/network.txt", group=GROUPS),
        nodes=expand(
            "results/network_analysis/{{region}}/{group}/nodes.tsv", group=GROUPS
        ),
        samples="results/sample_qc/{region}/samples_kept.tsv",
        network_utils="workflow/scripts/R/network_utils.R",
    output:
        pairs="results/network_analysis/{region}/comparison_pairs.tsv",
        convergence="results/network_analysis/{region}/convergence_index.tsv",
    log:
        "logs/network_analysis/{region}/comparison.log",
    conda:
        "envs/network_analysis.yaml"
    params:
        groups=GROUPS,
    script:
        "scripts/network_comparison.R"


# Rewiring of every gene by AD in women and in men, and rewired genes x DEGs
rule gene_rewiring:
    input:
        networks=expand("results/aracne/{{region}}/{group}/network.txt", group=GROUPS),
        regulators="results/aracne/{region}/regulators.txt",
        de_female=f"results/deseq2/{{region}}/{config['figures']['female_contrast']}.tsv",
        de_male=f"results/deseq2/{{region}}/{config['figures']['male_contrast']}.tsv",
        de_interaction=f"results/deseq2/{{region}}/{config['figures']['interaction_contrast']}.tsv",
        network_utils="workflow/scripts/R/network_utils.R",
        overlap_utils="workflow/scripts/R/overlap_utils.R",
    output:
        genes="results/network_analysis/{region}/gene_rewiring.tsv",
        tests="results/network_analysis/{region}/rewiring_vs_de.tsv",
    log:
        "logs/network_analysis/{region}/gene_rewiring.log",
    conda:
        "envs/network_analysis.yaml"
    params:
        groups=GROUPS,
        min_degree=config["network_analysis"]["rewiring"]["min_degree"],
        top_rewired=config["network_analysis"]["rewiring"]["top_rewired"],
        sensitivity=config["network_analysis"]["rewiring"]["sensitivity"],
        n_perm=config["network_analysis"]["rewiring"]["n_perm"],
        strata=config["network_analysis"]["rewiring"]["strata"],
        seed=config["network_analysis"]["rewiring"]["seed"],
    script:
        "scripts/gene_rewiring.R"


# Function of the genes rewired in women only, in men only and in both
rule rewiring_enrichment:
    input:
        genes="results/network_analysis/{region}/gene_rewiring.tsv",
    output:
        "results/network_analysis/{region}/rewiring_enrichment.tsv",
    log:
        "logs/network_analysis/{region}/rewiring_enrichment.log",
    conda:
        "envs/gsea.yaml"
    params:
        min_size=config["network_analysis"]["rewiring_enrichment"]["min_size"],
        max_size=config["network_analysis"]["rewiring_enrichment"]["max_size"],
        padj=config["network_analysis"]["rewiring_enrichment"]["padj"],
    script:
        "scripts/rewiring_enrichment.R"


# ---- 9. Figures of the networks ---------------------------------------------


# Main figure: (a) rewiring in women vs in men, (b) rewired genes x DEGs,
# (c) function of the genes rewired in one sex only, (d) convergence/divergence
# index, (e) edge Jaccard AD vs CT per sex
rule plot_networks_by_sex:
    input:
        convergence=collect(
            "results/network_analysis/{region}/convergence_index.tsv",
            region=REGIONS.index,
        ),
        pairs=collect(
            "results/network_analysis/{region}/comparison_pairs.tsv",
            region=REGIONS.index,
        ),
        genes=collect(
            "results/network_analysis/{region}/gene_rewiring.tsv", region=REGIONS.index
        ),
        tests=collect(
            "results/network_analysis/{region}/rewiring_vs_de.tsv", region=REGIONS.index
        ),
        enrichment=collect(
            "results/network_analysis/{region}/rewiring_enrichment.tsv",
            region=REGIONS.index,
        ),
        regions=config["samples"],
        theme="workflow/scripts/R/theme_pub.R",
    output:
        pdf="results/plots/main/networks_ad_by_sex.pdf",
        jpeg="results/plots/main/networks_ad_by_sex.jpeg",
    log:
        "logs/plot_networks_by_sex.log",
    conda:
        "envs/plots_r.yaml"
    params:
        collection=config["network_figures"]["collection"],
        top_terms=config["network_figures"]["top_terms"],
    script:
        "scripts/plot_networks_by_sex.R"


